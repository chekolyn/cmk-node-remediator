# E2E Test Configuration
#
# Copy this file to e2e/local.env and fill in your values.
# Or export the variables before running: bash e2e/run-e2e.sh
#
# All values have defaults — override in local.env or via env vars.

# ── Cluster Settings ──────────────────────────────────────────────
# Set these in local.env (not committed) or via env vars
CLUSTER_NAME="${CLUSTER_NAME:-}"
CLUSTER_ID="${CLUSTER_ID:-}"
PROJECT_ID="${PROJECT_ID:-}"
LOCATION="${LOCATION:-}"

# ── Registry Settings ────────────────────────────────────────────
REGISTRY_URL="${REGISTRY_URL:-}"
REGISTRY_REPO="${REGISTRY_REPO:-cmk-node-remediation.${PROJECT_ID}}"
IMAGE_TAG="${IMAGE_TAG:-v0.0.1}"

# ── Crusoe API Settings ──────────────────────────────────────────
# For the K8s secret (not the registry token)
CRUSOE_API_URL="${CRUSOE_API_URL:-https://api.cloud.crusoe.ai/v1alpha5}"
CRUSOE_API_KEY="${CRUSOE_API_KEY:-}"  # Set this or use --api-key flag

# ── Helm Settings ────────────────────────────────────────────────
NAMESPACE="${NAMESPACE:-cmk-node-remediation}"
RELEASE_NAME="${RELEASE_NAME:-cmk-node-remediation}"

# ── Test Thresholds (fast for testing) ──────────────────────────
# Override these for different clusters
VM_INSTANCE_TYPE_FILTER="${VM_INSTANCE_TYPE_FILTER:-c1a.*}"
CORDON_THRESHOLD="${CORDON_THRESHOLD:-30m}"
ACTION_THRESHOLD="${ACTION_THRESHOLD:-1h}"
COOLDOWN="${COOLDOWN:-15m}"
SCHEDULE="${SCHEDULE:-*/5 * * * *}"
GLOBAL_MAX_CORDONED="${GLOBAL_MAX_CORDONED:-2}"
PER_POOL_MAX_CORDONED="${PER_POOL_MAX_CORDONED:-1}"
